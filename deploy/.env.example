# AiNxt OS — example environment file.
#
# Copy this file to deploy/.env and fill in only the values your deployment needs.
# deploy/.env itself is gitignored (see .gitignore); this .env.example is the tracked template.
# None of these variables are required to start the daemon — with nothing set, the "local"
# provider has no base_url and the runtime falls back to offline mode (see config.toml).

# Base URL for the OSS "local" model provider (an OpenAI-schema-compatible endpoint).
# Leave unset to run fully offline. Examples:
#   Ollama:  http://localhost:11434/v1
#   vLLM:    http://localhost:8000/v1
LLM_BASE_URL=

# API key for the "local" provider above, if your endpoint requires one. Most local
# Ollama/vLLM deployments do not.
LOCAL_API_KEY=

# API keys for the optional hosted-provider adapters in crates/ainxt-providers. Only set
# the ones you intend to use; each provider is inert without its key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
